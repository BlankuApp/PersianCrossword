        "پریشان و سرگشته",
        "عنوانی برای فوروارد فوتبال"
      ],
      "7": [
        "مرکب انسان‌ها قبل از ساخت خودرو",
        "گیاهی طبی از تیره شب‌بویان",
        "پابرجا"
      ],
      "8": [
        "دستخط خوش",
        "صدای بلند",
        "یک طبقه از ساختمان"
