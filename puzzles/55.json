  "clues": {
    "horizontal": {
      "1": [
        "بازیگر سریال جدید «دو نیمه ماه» که بهمن ۱۴۰۴ پخش شد",
        "ستودن"
      ],
      "2": [
        "همگی، سراسر",
        "ته نشین مایعات",
        "بالاترین مقطع تحصیلی دانشگاهی در ایران"
      ],
      "3": [
        "شاعر و نویسنده ایرلندی با نام «اسکار»",
        "منسوج",
        "بیرون آمدن"
      ],
      "4": [
        "پول خون",
        "گندم",
        "روییده بر انگشتان",
        "فراموشی"
      ],
      "5": [
        "عدد گلر",
        "نام دخترانه",
        "منزلت"
      ],
      "6": [
        "در محل نامناسب",
        "به هم سائیده شده",
        "برادر آبادانی"
      ],
      "7": [
        "بزرگواری",
        "تفتیش و ممیزی",
        "با «تیز» آید"
      ],
      "8": [
        "اشاره رمزگونه به شخص ثالث",
        "غذای محلی اردبیل",
        "روز آینده"
      ],
      "9": [
        "نوک مثلث",
        "وسیله سنجش",
        "گاز موجود در سطح خورشید"
      ],
      "10": [
        "اشاره به دور",
        "مسیر الکترونیکی",
        "تر و تازگی"
      ],
      "11": [
        "اهل هرات",
        "مهم بودن",
        "زمینه هنری"
      ],
      "12": [
        "حب فرار!",
        "دید، دیدگاه",
        "ورود غیرمجاز رایانه‌ای",
        "خمیده"
      ],
      "13": [
        "اتاق راه‌آهن",
        "رنگی برای فرش",
        "سایت شخصی"
      ],
      "14": [
        "رازها",
        "رابط الکتریکی",
        "توانایی، قدرت"
      ],
      "15": [
        "پدر پدر یا پدر مادر",
        "رودرروی هم ایستادن"
      ]
    },
    "vertical": {
      "1": [
        "شرکت آلمانی تولید کننده خودروهای لوکس",
        "تیم بوشهری"
      ],
      "2": [
        "دانه‌دانه",
        "پادشاه بزرگ",
        "بنفش بسیار روشن"
      ],
      "3": [
