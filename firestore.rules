rules_version = '2';

// Deploy: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // A player reads and writes only their own progress (scoreboard, per-puzzle letters,
    // and the pre-scoreboard `puzzles` collection that older app versions still use).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Admins carry the `admin` custom claim (scripts/grantAdmin.ts).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    // Published puzzles (catalog/index + puzzlePacks/{pack}) are public so the app can download
    // them even before sign-in. Admins publish from the app; scripts use the admin SDK.
    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /puzzlePacks/{pack} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Unpublished puzzles: admins only.
    match /drafts/{id} {
      allow read, write: if isAdmin();
    }
    // Everything else — including aiUsage, which only the askAi function (admin SDK) touches —
    // is denied by default.
  }
}
