rules_version = '2';

// Deploy: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // A player reads and writes only their own progress (scoreboard, per-puzzle letters,
    // and the pre-scoreboard `puzzles` collection that older app versions still use).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Published puzzles (catalog/index + puzzlePacks/{pack}) are public so the app can download
    // them even before sign-in. Only scripts/uploadPuzzles.ts (admin SDK) writes them.
    match /catalog/{doc} {
      allow read: if true;
    }
    match /puzzlePacks/{pack} {
      allow read: if true;
    }
    // Everything else — including aiUsage, which only the askAi function (admin SDK) touches —
    // is denied by default.
  }
}
