{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run App Dev Server (LAN)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--host"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^ERROR.*$",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*vite.*$",
          "endsPattern": "^.*ready in .*ms.*$"
        }
      }
    },
    {
      "label": "Grid Importer: Backend",
      "type": "shell",
      "command": "${workspaceFolder}/tools/grid-importer/backend/.venv/bin/uvicorn",
      "args": ["app:app", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/tools/grid-importer/backend"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\uvicorn.exe"
      },
      "presentation": {
        "group": "grid-importer",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": {
          "regexp": "^ERROR.*$",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started reloader process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "Grid Importer: Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/tools/grid-importer/frontend"
      },
      "presentation": {
        "group": "grid-importer",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite-importer",
        "pattern": {
          "regexp": "^ERROR.*$",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*vite.*$",
          "endsPattern": "^.*ready in .*ms.*$"
        }
      }
    },
    {
      "label": "Grid Importer: Run All",
      "dependsOn": ["Grid Importer: Backend", "Grid Importer: Frontend"],
      "dependsOrder": "parallel",
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Build & Sync",
      "type": "shell",
      "command": "npm run build && npx cap sync android",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Android\\Android Studio\\jbr"
        }
      },
      "presentation": {
        "group": "android",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Build Release App Bundle",
      "type": "shell",
      "command": "npm run build && npx cap sync android && ./android/gradlew -p android bundleRelease",
      "windows": {
        "command": "npm run build && npx cap sync android && .\\android\\gradlew.bat -p android bundleRelease"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Android\\Android Studio\\jbr"
        }
      },
      "group": "build",
      "presentation": {
        "group": "android",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Open in Android Studio",
      "type": "shell",
      "command": "npx cap open android",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "android",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Android: Run on Device/Emulator",
      "type": "shell",
      "command": "npm run build && npx cap sync android && npx cap run android --target Medium_Phone",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Android\\Android Studio\\jbr"
        }
      },
      "presentation": {
        "group": "android",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Start Emulator",
      "type": "shell",
      "command": "${env:ANDROID_HOME}/emulator/emulator.exe",
      "args": ["-avd", "Medium_Phone"],
      "windows": {
        "command": "${env:ANDROID_HOME}\\emulator\\emulator.exe"
      },
      "presentation": {
        "group": "android",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "android-emulator",
        "pattern": {
          "regexp": "^ERROR.*$",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*emulator.*$",
          "endsPattern": "^.*boot completed.*$"
        }
      }
    }
  ]
}
