{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run App Dev Server (LAN)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--host"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^ERROR.*$",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*vite.*$",
          "endsPattern": "^.*ready in .*ms.*$"
        }
      }
    },
    {
      "label": "Grid Importer: Backend",
      "type": "shell",
      "command": "${workspaceFolder}/tools/grid-importer/backend/.venv/bin/uvicorn",
      "args": ["app:app", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}/tools/grid-importer/backend"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\uvicorn.exe"
      },
      "presentation": {
        "group": "grid-importer",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": {
          "regexp": "^ERROR.*$",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started reloader process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "Grid Importer: Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/tools/grid-importer/frontend"
      },
      "presentation": {
        "group": "grid-importer",
        "panel": "dedicated",
        "reveal": "always",
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite-importer",
        "pattern": {
          "regexp": "^ERROR.*$",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*vite.*$",
          "endsPattern": "^.*ready in .*ms.*$"
        }
      }
    },
    {
      "label": "Grid Importer: Run All",
      "dependsOn": ["Grid Importer: Backend", "Grid Importer: Frontend"],
      "dependsOrder": "parallel",
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    }
  ]
}
