rules_version = '2';

// Deploy: npx firebase-tools deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // Puzzle images are public; only scripts/uploadPuzzles.ts (admin SDK) writes them.
    match /puzzles/{allPaths=**} {
      allow read: if true;
    }
    // Everything else is denied by default.
  }
}
